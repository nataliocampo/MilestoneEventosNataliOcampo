@model MilestoneEventosNataliOcampo.web.Models.TurnosVM

@{
	ViewData["Title"] = "Eliminar turno";
}

<h1>Eliminar turno</h1>

<h3>¿Confirma que desea eliminar este turno?</h3>

<div>
	<dl class="row">
		<dt class = "col-sm-2">
			Paciente
		</dt>
		<dd class = "col-sm-10">
			@Model.Paciente.Nombre @Model.Paciente.Apellido
		</dd>

		<dt class = "col-sm-2">
			DNI
		</dt>
		<dd class = "col-sm-10">
			@Model.Paciente.DNI
		</dd>

		
		<dt class="col-sm-2">Fecha</dt>
		<dd class="col-sm-10">@Model.FechaTurno.ToString("dd/MM/yyyy")</dd>

		<dt class="col-sm-2">Hora</dt>
		<dd class="col-sm-10">@Model.HoraTurno.ToString("HH:mm")</dd>

		<dt class="col-sm-2">Médico</dt>
		<dd class="col-sm-10">@Model.Medico</dd>

		<dt class = "col-sm-2">
			Especialidad
		</dt>
		<dd class = "col-sm-10">
			@Model.Especialidad
		</dd>

	</dl>

	<form asp-action="Delete" method="post">
		<input asp-for="CodigoTurno" type="hidden" />
		<input type="submit" value="Cancelar" class="btn btn-danger" />
		<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
	</form>
</div>
