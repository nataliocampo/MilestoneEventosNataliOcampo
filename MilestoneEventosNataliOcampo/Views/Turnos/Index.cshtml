@model IEnumerable<MilestoneEventosNataliOcampo.web.Models.TurnosVM>

@{
	ViewData["Title"] = "Turnos";
}

<h1>Turnos</h1>

@if (User.HasClaim("Permiso", "Turnos.Crear"))
{
    <a asp-action="Create" class="btn btn-primary">Nuevo turno</a>
}

@if (Model == null || !Model.Any())
{
	<p>No hay turnos para mostrar.</p>
}
else
{
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Código</th>
				<th>Paciente</th>
				<th>Fecha</th>
				<th>Hora</th>
				<th>Especialidad</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>@item.CodigoTurno</td>
				<td>@(item.Paciente?.Nombre) @(" ") @(item.Paciente?.Apellido) (@item.Paciente?.DNI)</td>
				<td>@item.FechaTurno.ToString("d")</td>
				<td>@item.HoraTurno.ToString("HH:mm")</td>
				<td>@item.Especialidad</td>
				<td>
							
						@if (User.HasClaim("Permiso", "Turnos.Editar"))
						{
							<a asp-action="Edit" asp-route-CodigoTurno="@item.CodigoTurno">Editar</a>
						}
						@if (User.HasClaim("Permiso", "Turnos.Eliminar"))
						{
							<a asp-action="Delete" asp-route-CodigoTurno="@item.CodigoTurno">Cancelar</a>
						}
						<a asp-action="Details" asp-route-CodigoTurno="@item.CodigoTurno">Detalle</a>
					</td>
			</tr>
		}
		</tbody>
	</table>
}
