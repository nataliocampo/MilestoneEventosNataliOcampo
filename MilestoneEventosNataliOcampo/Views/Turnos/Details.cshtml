@model MilestoneEventosNataliOcampo.web.Models.TurnosVM

@{
	ViewData["Title"] = "Detalles del turno";
}

<h1>Detalles del turno</h1>

<div>
	<dl class="row">
		<dt class = "col-sm-2">
			Código
		</dt>
		<dd class = "col-sm-10">
			@Model.CodigoTurno
		</dd>

		<dt class = "col-sm-2">
			Paciente
		</dt>
		<dd class = "col-sm-10">
			@Model.Paciente.Nombre @Model.Paciente.Apellido
		</dd>

		<dt class = "col-sm-2">
			DNI
		</dt>
		<dd class = "col-sm-10">
			@Model.Paciente.DNI
		</dd>

		<dt class = "col-sm-2">
			Fecha
		</dt>
		<dd class = "col-sm-10">
			@Model.FechaTurno.ToString("g")
		</dd>

		<dt class = "col-sm-2">
			Especialidad
		</dt>
		<dd class = "col-sm-10">
			@Model.Especialidad
		</dd>
	</dl>

	<p>
		<a asp-action="Edit" asp-route-CodigoTurno="@Model.CodigoTurno" class="btn btn-primary">Editar</a>
		<a asp-action="Delete" asp-route-CodigoTurno="@Model.CodigoTurno" class="btn btn-danger">Eliminar</a>
		<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
	</p>
</div>
