@model MilestoneEventosNataliOcampo.web.Models.TurnoAltaVM

@{
	ViewData["Title"] = "Crear turno";
}

<h1>Crear turno</h1>


@if (ViewBag.Mensaje != null)
{
	<div class="alert alert-warning">@ViewBag.Mensaje</div>
}

<form asp-action="Create" method="post">
	<div asp-validation-summary="ModelOnly" class="text-danger"></div>
	@if (ViewBag.PacienteExiste != true)
		{
			<h5 class="mt-4">Datos del paciente</h5>
			<div class="form-group">
				<label asp-for="Paciente.Nombre" class="control-label"></label>
				<input asp-for="Paciente.Nombre" class="form-control" />
				<span asp-validation-for="Paciente.Nombre" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="Paciente.Apellido" class="control-label"></label>
				<input asp-for="Paciente.Apellido" class="form-control" />
				<span asp-validation-for="Paciente.Apellido" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="Paciente.DNI" class="control-label"></label>
				<input asp-for="Paciente.DNI" class="form-control" />
				<span asp-validation-for="Paciente.DNI" class="text-danger"></span>
			</div>
		}
		<div class="form-group">

		@if (ViewBag.PacienteExiste == true)
		{
			<p class="mb-3"><strong>Paciente:</strong> @ViewBag.PacienteNombre</p>
		}
			<label asp-for="FechaTurno" class="control-label"></label>
			<input asp-for="FechaTurno" type="date" class="form-control" />
			<span asp-validation-for="FechaTurno" class="text-danger"></span>
		</div>
	
	@* selector de hora- turnos disponibles  *@
	<div class="form-group">
		<label asp-for="HoraTurno" class="control-label"></label>
		<select asp-for="HoraTurno" asp-items="Model.Horarios" class="form-control">
			<option value="">-- Seleccione --</option>
		</select>
		<span asp-validation-for="HoraTurno" class="text-danger"></span>
	</div>


	<div class="form-group">
		<label asp-for="EspecialidadId" class="control-label"></label>
		<select asp-for="EspecialidadId" asp-items="Model.Especialidades" class="form-control">
			<option value="">-- Seleccione --</option>
		</select>
		<span asp-validation-for="EspecialidadId" class="text-danger"></span>
	</div>

	<div class="form-group">
		<input type="submit" value="Crear" class="btn btn-primary" />
		<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
	</div>
</form>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
